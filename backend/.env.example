# Postgres runs on the Windows RTX PC, reached over Tailscale — not localhost.
#
# DATABASE_URL is the APPLICATION's runtime connection — must be a
# restricted role (NOSUPERUSER NOBYPASSRLS), never the admin/bootstrap
# role. Either one silently makes Row Level Security a no-op with no
# error (SCHEMA.md, Row Level Security — CRITICAL). Run migrations
# separately with the admin role's connection string (e.g.
# `DATABASE_URL=postgresql://odin:<pw>@<ip>:5432/odin sqlx migrate run`),
# never with this one.
DATABASE_URL=postgresql://odin_app:changeme@<windows-tailscale-ip>:5432/odin
DB_POOL_SIZE=10
PORT=8080

REDIS_URL=redis://<windows-tailscale-ip>:6379

# FastAPI AI service, also on the Windows RTX PC (Block 4/5).
AI_SERVICE_URL=http://<windows-tailscale-ip>:8000

# Generate with: openssl rand -hex 32 — never reuse the example below.
JWT_SECRET=<random-hex-secret>
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
OTP_EXPIRY_MINUTES=10
# Also governs the "OTP just verified, about to submit" window for
# password reset (auth/otp.rs) — not signup-specific despite the name.
VERIFIED_SIGNUP_TOKEN_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=12
# Optional (all three together) — omit to use auth/email.rs's
# console-log stub sender instead of actually sending mail. Real
# delivery is plain SMTP (a deliberate swap from Resend — see
# auth/email.rs's own comment for why), e.g. through a Gmail account's
# App Password (not your real Google password — generate one at
# https://myaccount.google.com/apppasswords, requires 2FA enabled).
# Google's own screen shows it grouped with spaces ("abcd efgh ijkl
# mnop") — remove them (config.rs strips them defensively too, but an
# UNQUOTED value with spaces breaks dotenvy's own .env parsing before
# that code ever runs, so fix it here regardless).
SMTP_RELAY=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=

# The real frontend origin the browser sends requests from — CORS
# rejects anything else. Defaults to http://localhost:5174 (Odin's
# pinned Vite dev port — see frontend/vite.config.ts's server.port; NOT
# Vite's own factory default of 5173, deliberately avoided since a
# separate local project may already own 5173) if unset, so this line
# is only needed once that origin is something else (a real deployed
# domain, a different local port, etc).
FRONTEND_ORIGIN=http://localhost:5174

# Defaults to false so local HTTP dev keeps working (a Secure cookie is
# silently refused by the browser over plain HTTP — this would break
# every auth flow, not just look insecure). Set to true once this is
# ever actually served over HTTPS (RULES.md Rule 49, deferred.md #16).
COOKIE_SECURE=false

# Block 11: sliding TTL (minutes) for a Redis-staged memoryless thread
# (memoryless:{thread_id}) — reset on every new message. PRD.md locks a
# separate MEMORYLESS_STAGED_UPLOAD_TTL_MINUTES for staged uploads
# specifically, shorter than casual message history — NOT actually
# implemented (deferred.md #32): uploads live inside this SAME thread
# blob/key today, so they share this exact TTL rather than their own.
# Documented deviation, not silently dropped.
# Lowered 60 -> 15 (deferred.md #55) — a deliberate value decision, not
# a bug fix; the anchor point and expiry-race handling were both
# already correct in code before this change.
MEMORYLESS_THREAD_TTL_MINUTES=15

# PRD.md, Memoryless Mode SIZE GUARDRAIL — enforced before embedding
# starts, so an oversized upload can't run uncapped OCR/chunk/embed
# compute (deferred.md #32).
MEMORYLESS_STAGED_UPLOAD_MAX_MB=25
MEMORYLESS_STAGED_UPLOAD_MAX_CHUNKS=200

# Rule 12 (never hardcode thresholds) — deferred.md #29. Redis lock TTL
# for generate_exercise_template()'s race-prevention (exercises/service.rs)
# — a cost optimization only, not the actual correctness guarantee (a
# real Postgres UNIQUE constraint is).
TEMPLATE_GEN_LOCK_TTL_SECONDS=120
