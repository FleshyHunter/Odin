# Windows-side .env for docker-compose.windows.yml — gitignored, lives
# only on the Windows machine, never committed. This is the template;
# copy it to .env alongside docker-compose.windows.yml and fill in
# real values there.

# Admin/bootstrap "odin" Postgres role (docker-compose.windows.yml's
# own header comment). The restricted odin_app role used by
# backend/.env's DATABASE_URL is a separate, manual step.
POSTGRES_PASSWORD=changeme

# Block 10 (Dify) — one API key per Dify Workflow app (see
# ai_service/app/acquisition/ and its setup instructions). All
# optional: unset means /acquire, /generate_dag,
# /generate_exercise_template, /classify_gap each return a clean 503
# rather than ai_service failing to boot.
DIFY_BASE_URL=https://api.dify.ai
DIFY_ACQUIRE_API_KEY=
DIFY_DAG_API_KEY=
DIFY_EXERCISE_TEMPLATE_API_KEY=
# deferred.md #2b — Stage 2 of the off-topic/DAG-gap classifier, own
# dedicated key so its model choice is swappable independently of DAG
# generation's.
DIFY_CLASSIFY_GAP_API_KEY=

# deferred.md #93 — real-time search tools for /generate/stream_with_
# tools (not yet wired to any real caller — see ai_service/app/search/).
# Both optional: unset WOLFRAM_APP_ID means that one tool fails soft
# per-call, same as Dify's own keys above. SEARXNG_URL only needs
# setting if the real deployment didn't use the default single-
# container port (8888) or host.docker.internal.
WOLFRAM_APP_ID=
SEARXNG_URL=http://host.docker.internal:8888
